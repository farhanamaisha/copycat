generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  username String @unique
  email    String @unique
  password String

  // Profile fields
  displayName String?
  bio         String?
  avatarUrl   String?

  emailVerified Boolean @default(false)
  isVerified    Boolean @default(false)
  isPremium     Boolean @default(false)

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Relations
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]

  // Social relations
  clone          Clone?
  posts          Post[]
  comments       Comment[]
  reactions      Reaction[]
  followers      Follow[]        @relation("following")
  following      Follow[]        @relation("follower")
  clowderMembers ClowderMember[]

  // Messages
  sentMessages     Message[] @relation("sender")
  receivedMessages Message[] @relation("receiver")

  // Training data
  trainingSessions TrainingSession[]

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  chatConversations     ChatConversation[]
  sentNotifications     Notification[]     @relation("notification_actor")
  receivedNotifications Notification[]     @relation("notification_receiver") 
  sentConnections     Connection[] @relation("sentConnections")
receivedConnections Connection[] @relation("receivedConnections")
}

model Clone {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  name                String
  avatarUrl           String?
  personalityProgress Int     @default(0)
  intelligenceScore   Int     @default(0)
  level               Int     @default(1)
  accuracyPercent     Int     @default(0)
  mood                String  @default("curious")
  isOnline            Boolean @default(false)
  trainingCount       Int     @default(0)

  traits TraitScore[]

  lastActive    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  conversations ChatConversation[]
  memories      CloneMemory[]
}

model TraitScore {
  id      String @id @default(cuid())
  clone   Clone  @relation(fields: [cloneId], references: [id], onDelete: Cascade)
  cloneId String

  name  String
  value Int    @default(0)

  @@unique([cloneId, name])
}

model Post {
  id       String @id @default(cuid())
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  content String
  tags    String[] @default([])

  likes    Reaction[] @relation("post_likes")
  comments Comment[]

  isLiked       Boolean @default(false)
  likesCount    Int     @default(0)
  isBookmarked  Boolean @default(false)
  isReposted    Boolean @default(false)
  repostsCount  Int     @default(0)
  commentsCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id       String @id @default(cuid())
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reaction {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  post   Post   @relation("post_likes", fields: [postId], references: [id], onDelete: Cascade)
  postId String

  type String @default("like")

  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Follow {
  id String @id @default(cuid())

  follower   User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId String

  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
}

model Clowder {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  avatarUrl   String?

  members ClowderMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClowderMember {
  id String @id @default(cuid())

  clowder   Clowder @relation(fields: [clowderId], references: [id], onDelete: Cascade)
  clowderId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  joinedAt DateTime @default(now())

  @@unique([clowderId, userId])
}

model Message {
  id String @id @default(cuid())

  sender   User   @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId String

  receiver   User   @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String

  content String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingSession {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  prompt   String
  response String
  analysis String? // JSON or summary of analysis

  traitsImproved TraitImprovement[]
  pointsEarned   Int                @default(0)

  createdAt DateTime @default(now())
}

model TraitImprovement {
  id String @id @default(cuid())

  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  traitName String
  delta     Int

  @@unique([sessionId, traitName])
}

model VerificationToken {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken String @unique

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PendingUser {
  id String @id @default(cuid())

  username String
  email    String @unique
  password String

  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([token])
}

model ChatConversation {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  clone   Clone  @relation(fields: [cloneId], references: [id], onDelete: Cascade)
  cloneId String

  title String?

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, cloneId])
  @@index([userId])
  @@index([cloneId])
}

model ChatMessage {
  id String @id @default(cuid())

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  role    MessageRole
  content String

  model      String?
  tokensUsed Int?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model CloneMemory {
  id String @id @default(cuid())

  clone   Clone  @relation(fields: [cloneId], references: [id], onDelete: Cascade)
  cloneId String

  memory String

  importance Int @default(1)

  createdAt DateTime @default(now())

  @@index([cloneId])
}

enum MessageRole {
  USER
  CLONE
  SYSTEM
}

model Notification {
  id String @id @default(cuid())

  user   User   @relation("notification_receiver", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  actor   User?   @relation("notification_actor", fields: [actorId], references: [id])
  actorId String?

  type NotificationType

  title   String
  message String

  isRead Boolean @default(false)

  referenceId String?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MESSAGE
  CLONE_UPDATE
  TRAINING_COMPLETE
  SYSTEM
}
model Connection {
  id String @id @default(cuid())

  senderId   String
  receiverId String

  sender   User @relation("sentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("receivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  status ConnectionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}